#!/usr/bin/python3
import socket, threading, select, signal, sys, time, getopt, datetime, os, re

# Listen
LISTENING_ADDR = '127.0.0.1'
if sys.argv[1:]:
  LISTENING_PORT = sys.argv[1]
else:
  LISTENING_PORT = 700  
#Pass
PASS = ''

# CONST
BUFLEN = 4096 * 4
TIMEOUT = 60
DEFAULT_HOST = '127.0.0.1:109'

def get_response():
    resp_file = '/etc/ws-stunnel-response'
    color = "cyan"
    text = "CONNECTED TO PREMIUM SERVER"

    if os.path.exists(resp_file):
        try:
            with open(resp_file, 'r') as f:
                lines = f.readlines()
                if len(lines) >= 1:
                    text = lines[0].strip()
                if len(lines) >= 2:
                    color = lines[1].strip()
        except:
            pass

    return ('HTTP/1.1 101 <b><font color="' + color + '"> ' + text + ' </font></b>\r\n\r\nContent-Length: 104857600000\r\n\r\n').encode('utf-8')

# Logging
LOG_FILE = '/var/log/ws-stunnel.log'

# Ensure Log Permission
try:
    if not os.path.exists(LOG_FILE):
        open(LOG_FILE, 'a').close()
    os.chmod(LOG_FILE, 0o666)
except:
    pass

def write_tunnel_log(action, local_port, remote_ip):
    try:
        with open(LOG_FILE, 'a') as f:
            ts = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            f.write("{}|{}|{}|{}\n".format(ts, action, local_port, remote_ip))
            f.flush()
            os.fsync(f.fileno())
    except:
        pass

class Server(threading.Thread):
    def __init__(self, host, port):
        threading.Thread.__init__(self)
        self.running = False
        self.host = host
        self.port = port
        self.threads = []
        self.threadsLock = threading.Lock()
        self.logLock = threading.Lock()

    def run(self):
        self.soc = socket.socket(socket.AF_INET)
        self.soc.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.soc.settimeout(2)
        intport = int(self.port)
        self.soc.bind((self.host, intport))
        self.soc.listen(0)
        self.running = True

        try:
            while self.running:
                try:
                    c, addr = self.soc.accept()
                    c.setblocking(1)
                except socket.timeout:
                    continue

                conn = ConnectionHandler(c, self, addr)
                conn.start()
                self.addConn(conn)
        finally:
            self.running = False
            self.soc.close()

    def printLog(self, log):
        self.logLock.acquire()
        print(log)
        self.logLock.release()

    def addConn(self, conn):
        try:
            self.threadsLock.acquire()
            if self.running:
                self.threads.append(conn)
        finally:
            self.threadsLock.release()

    def removeConn(self, conn):
        try:
            self.threadsLock.acquire()
            self.threads.remove(conn)
        finally:
            self.threadsLock.release()

    def close(self):
        try:
            self.running = False
            self.threadsLock.acquire()

            threads = list(self.threads)
            for c in threads:
                c.close()
        finally:
            self.threadsLock.release()


class ConnectionHandler(threading.Thread):
    def __init__(self, socClient, server, addr):
        threading.Thread.__init__(self)
        self.clientClosed = False
        self.targetClosed = True
        self.client = socClient
        self.client_buffer = ''
        self.server = server
        self.log = 'Connection: ' + str(addr)
        self.remote_addr = addr
        self.local_ephemeral_port = None

    def close(self):
        try:
            if not self.clientClosed:
                self.client.shutdown(socket.SHUT_RDWR)
                self.client.close()
        except:
            pass
        finally:
            self.clientClosed = True

        try:
            if not self.targetClosed:
                self.target.shutdown(socket.SHUT_RDWR)
                self.target.close()
        except:
            pass
        finally:
            self.targetClosed = True
            if self.local_ephemeral_port:
                 write_tunnel_log("DISCONNECT", self.local_ephemeral_port, self.remote_addr[0])

    def run(self):
        try:
            # We use a slight loop to ensure we consume messy/split headers
            # without instantly crashing on half-sent payloads.
            self.client.settimeout(3)
            try:
                self.client_buffer = self.client.recv(BUFLEN)
            except socket.timeout:
                self.client_buffer = b''

            client_buffer_str = self.client_buffer.decode('utf-8', errors='ignore')

            # Look for split payload logic - read additional buffer if split is indicated
            # or if the payload ends unexpectedly without full headers
            if 'Upgrade: websocket' in client_buffer_str and not '\r\n\r\n' in client_buffer_str:
                try:
                     extra = self.client.recv(BUFLEN)
                     self.client_buffer += extra
                     client_buffer_str += extra.decode('utf-8', errors='ignore')
                except:
                     pass

            # Read a few more times with a very short timeout to catch any trailing split garbage
            # like "HTTP/ 1\n\n" sent milliseconds later.
            self.client.settimeout(0.5)
            try:
                while True:
                    extra = self.client.recv(BUFLEN)
                    if not extra:
                        break
                    self.client_buffer += extra
                    client_buffer_str += extra.decode('utf-8', errors='ignore')
            except socket.timeout:
                pass
            except:
                pass
            self.client.setblocking(1)

            # Try to get IP from X-Forwarded-For if available (behind Nginx)
            forwarded = self.findHeader(client_buffer_str, 'X-Forwarded-For')
            if forwarded != '':
                 # X-Forwarded-For: client, proxy1, proxy2
                 self.remote_addr = (forwarded.split(',')[0].strip(), self.remote_addr[1])
            else:
                 # Try X-Real-IP
                 real_ip = self.findHeader(client_buffer_str, 'X-Real-IP')
                 if real_ip != '':
                     self.remote_addr = (real_ip, self.remote_addr[1])

            hostPort = self.findHeader(client_buffer_str, 'X-Real-Host')

            if hostPort == '':
                hostPort = DEFAULT_HOST

            # Absolute Fallback (Mencegah regex gagal merender string kosong dari payload kotor)
            if not hostPort or hostPort.strip() == '':
                hostPort = '127.0.0.1:109'

            passwd = self.findHeader(client_buffer_str, 'X-Pass')
				
            if len(PASS) != 0 and passwd == PASS:
                self.method_CONNECT(hostPort)
            elif len(PASS) != 0 and passwd != PASS:
                self.client.send(b'HTTP/1.1 400 WrongPass!\r\n\r\n')
            elif hostPort.startswith('127.0.0.1') or hostPort.startswith('localhost') or hostPort == '127.0.0.1:109':
                self.method_CONNECT(hostPort)
            else:
                self.client.send(b'HTTP/1.1 403 Forbidden!\r\n\r\n')

        except Exception as e:
            self.log += ' - error: ' + str(e)
            self.server.printLog(self.log)
            pass
        finally:
            self.close()
            self.server.removeConn(self)

    def findHeader(self, head, header):
        # Gunakan regex untuk menangani newlines yang kotor/berantakan dari aplikasi tunneling mobile
        # (seperti \r\n, \n, atau string miring seperti \rn)
        match = re.search(r'(?i)%s:\s*([^\r\n]+)' % re.escape(header), head)
        if match:
            return match.group(1).strip()

        # Fallback cara lama jika regex miss (dengan toleransi delimiter)
        aux = head.find(header + ': ')
        if aux == -1:
            return ''
        aux = head.find(':', aux)
        head = head[aux+2:]

        # Cari batas akhir baris (bisa \r\n atau cuma \n)
        end_idx = head.find('\r\n')
        if end_idx == -1:
            end_idx = head.find('\n')

        if end_idx == -1:
            return head.strip()

        return head[:end_idx].strip()

    def connect_target(self, host):
        i = host.find(':')
        if i != -1:
            port = int(host[i+1:])
            host = host[:i]
        else:
            if self.method=='CONNECT':
                port = 443
            else:
                port = sys.argv[1]

        (soc_family, soc_type, proto, _, address) = socket.getaddrinfo(host, port)[0]

        self.target = socket.socket(soc_family, soc_type, proto)
        self.targetClosed = False
        self.target.connect(address)

        # Log the mapping
        try:
            self.local_ephemeral_port = self.target.getsockname()[1]
            write_tunnel_log("CONNECT", self.local_ephemeral_port, self.remote_addr[0])
        except:
            pass

    def method_CONNECT(self, path):
        self.log += ' - CONNECT ' + path

        self.connect_target(path)
        self.client.sendall(get_response())

        # Strip out ALL HTTP headers we consumed.
        # Since the payload might be split or contain chained requests (GET... \r\n\r\n PATCH... \r\n\r\n)
        # We must find the *last* occurrence of \r\n\r\n to ensure we don't accidentally forward
        # HTTP garbage to the SSH server (which expects SSH-2.0-...)

        # We also need to handle cases where the client sends \n\n instead of \r\n\r\n
        end_idx = self.client_buffer.rfind(b'\r\n\r\n')
        if end_idx == -1:
             end_idx = self.client_buffer.rfind(b'\n\n')
             offset = 2
        else:
             offset = 4

        if end_idx != -1:
             # Strip all HTTP headers
             remaining = self.client_buffer[end_idx + offset:]
             # Check if there is still "HTTP/" string in the remaining buffer
             # HTTP custom might send "HTTP/ 1\n\n" as the very last split payload.
             # If the remaining data is just HTTP garbage and not an SSH handshake, we drop it.
             if b'HTTP/' in remaining and not b'SSH-' in remaining:
                  remaining = b''
             self.client_buffer = remaining
        else:
             self.client_buffer = b''

        # If there's any data left (like SSH-2.0-...), send it to the target immediately
        if self.client_buffer:
             try:
                 self.target.sendall(self.client_buffer)
             except:
                 pass

        self.client_buffer = b''

        self.server.printLog(self.log)
        self.doCONNECT()

    def doCONNECT(self):
        socs = [self.client, self.target]
        count = 0
        error = False
        while True:
            count += 1
            (recv, _, err) = select.select(socs, [], socs, 3)
            if err:
                error = True
            if recv:
                for in_ in recv:
                    try:
                        data = in_.recv(BUFLEN)
                        if data:
                            if in_ is self.target:
                                self.client.send(data)
                            else:
                                while data:
                                    byte = self.target.send(data)
                                    data = data[byte:]

                            count = 0
                        else:
                            break
                    except:
                        error = True
                        break
            if count == TIMEOUT:
                error = True
            if error:
                break


def print_usage():
    print('Usage: proxy.py -p <port>')
    print('       proxy.py -b <bindAddr> -p <port>')
    print('       proxy.py -b 0.0.0.0 -p 1080')

def parse_args(argv):
    global LISTENING_ADDR
    global LISTENING_PORT
    
    try:
        opts, args = getopt.getopt(argv,"hb:p:",["bind=","port="])
    except getopt.GetoptError:
        print_usage()
        sys.exit(2)
    for opt, arg in opts:
        if opt == '-h':
            print_usage()
            sys.exit()
        elif opt in ("-b", "--bind"):
            LISTENING_ADDR = arg
        elif opt in ("-p", "--port"):
            LISTENING_PORT = int(arg)


def main(host=LISTENING_ADDR, port=LISTENING_PORT):
    print("\n:-------PythonProxy-------:\n")
    print("Listening addr: " + LISTENING_ADDR)
    print("Listening port: " + str(LISTENING_PORT) + "\n")
    print(":-------------------------:\n")

    # Truncate Log on Start to clean stale ports
    try:
        open(LOG_FILE, 'w').close()
        os.chmod(LOG_FILE, 0o666)
    except:
        pass

    server = Server(LISTENING_ADDR, LISTENING_PORT)
    server.start()
    while True:
        try:
            time.sleep(2)
        except KeyboardInterrupt:
            print('Stopping...')
            server.close()
            break

